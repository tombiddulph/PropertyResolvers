<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynAnalyzer>true</IsRoslynAnalyzer>

        <RootNamespace>PropertyResolvers.Generators</RootNamespace>
        <AssemblyName>PropertyResolvers.Generators</AssemblyName>

        <!-- NuGet Package Configuration -->
        <IsPackable>true</IsPackable>
        <PackageId>PropertyResolvers</PackageId>
        <Version>2.5.0</Version>
        <Authors>Tom Biddulph</Authors>
        <Description>A source generator that creates property resolver classes for types with
            matching properties. Use assembly-level attributes to generate resolvers that can
            retrieve property values from objects at runtime.</Description>
        <PackageTags>source-generator;analyzer;roslyn;properties;reflection</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>

        <!-- Runtime attributes are a public dependency; Roslyn tooling stays private. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>true</DevelopmentDependency>

        <!-- Suppress warnings about netstandard2.0 compatibility -->
        <NoWarn>$(NoWarn);NU5128</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0"  PrivateAssets="all" ExcludeAssets="runtime"  />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PropertyResolvers.Attributes\PropertyResolvers.Attributes.csproj"
                          GeneratePathProperty="true" />
        <ProjectReference Include="..\PropertyResolvers.CodeFixes\PropertyResolvers.CodeFixes.csproj"
                          ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <!-- The generator has no runtime dependency on the attributes assembly. -->
    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="../PropertyResolvers.CodeFixes/bin/$(Configuration)/netstandard2.0/PropertyResolvers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <!-- Public attributes/runtime API are supplied by the versioned package dependency. -->
    <ItemGroup>
        <None Include="build/PropertyResolvers.props" Pack="true" PackagePath="buildTransitive/PropertyResolvers.props" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\Readme.md"
            Pack="true"
            PackagePath="\" />
    </ItemGroup>
</Project>
